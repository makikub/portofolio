---
const phases = [
  { no: '01', en: 'FRAME', ja: '判断条件を揃える', body: '目的、利用者、制約、受け入れ条件を明確にし、人とAIが同じゴールを見られる状態にします。' },
  { no: '02', en: 'DELEGATE', ja: '実行を委ねる', body: '調査、実装、レビューを適切な単位に分け、AIエージェントへ委譲できるコンテキストを設計します。' },
  { no: '03', en: 'VERIFY', ja: '実環境で確かめる', body: 'テスト、レビュー、実際の操作、リリース成果物を通して、意図した価値と安全性を人が確認します。' },
  { no: '04', en: 'LEARN', ja: '学びを仕組みに戻す', body: '結果を文書、ルール、スキル、手順へ反映し、次の開発がより速く確かになる循環を作ります。' },
];
---
<section id="approach" class="model-block section-shell" aria-labelledby="model-title">
  <div class="section-heading split-heading">
    <div><p class="kicker">04 / AI-DRIVEN DELIVERY</p><h2 id="model-title">AIに任せるほど、<br />人の設計を明確に。</h2></div>
    <p>AIを単なる作業短縮に使わず、判断・委譲・検証・学習が循環する開発システムとして設計します。</p>
  </div>
  <ol class="phase-list">
    {phases.map((phase) => <li><span class="phase-no">{phase.no}</span><div><p class="phase-en">{phase.en}</p><h3>{phase.ja}</h3></div><p>{phase.body}</p></li>)}
  </ol>
</section>
