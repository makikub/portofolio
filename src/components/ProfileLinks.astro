---
import externalLinks from '../data/external_links.json';

const wantedly = externalLinks.platforms.find((platform) => platform.name === 'Wantedly');

interface ProfileLink {
  label: string;
  title: string;
  description: string;
  url: string;
  icon: string;
}

const isProfileLink = (link: ProfileLink | undefined): link is ProfileLink => Boolean(link);

const profileLinks = [
  wantedly && {
    label: 'Wantedly',
    title: '経歴',
    description: '職務経歴や仕事に対する考え方をまとめています。',
    url: wantedly.url,
    icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z',
  },
].filter(isProfileLink);
---

<section class="py-18 md:py-24 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="mb-12">
      <p class="text-sm font-semibold text-neutral-500 mb-3">Career</p>
      <h2 class="text-4xl font-bold text-neutral-900 mb-4 tracking-tight">経歴リンク</h2>
      <p class="text-neutral-500 max-w-2xl text-lg leading-relaxed">
        詳しい職務経歴や仕事に対する考え方は Wantedly にまとめています。
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {profileLinks.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex gap-4 p-6 bg-neutral-50 border border-neutral-200 rounded-lg hover:bg-white hover:shadow-xl hover:shadow-neutral-100/50 transition-all"
        >
          <div class="w-12 h-12 shrink-0 rounded-lg bg-white border border-neutral-200 flex items-center justify-center">
            <svg class="w-6 h-6 text-neutral-800" viewBox="0 0 24 24" fill="currentColor">
              <path d={link.icon} />
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">{link.label}</p>
            <p class="font-bold text-neutral-900 mb-1">{link.title}</p>
            <p class="text-sm text-neutral-500 leading-relaxed">{link.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
