---
const navItems = [
  { name: '作ったもの', href: '/' }, { name: '経歴・できること', href: '/profile/' }, { name: '発信活動', href: '/activity/' }, { name: '問い合わせ', href: '/contact/' },
];
const path = Astro.url.pathname;
const active = (href:string) => href === '/' ? path === '/' || path.startsWith('/projects/') : path.startsWith(href);
---
<header class="site-header">
  <nav class="header-inner" aria-label="メインナビゲーション">
    <a href="/" class="site-name"><span>MK</span><span>masaki.k</span></a>
    <button class="menu-button" aria-expanded="false" aria-controls="site-nav"><span></span><span></span><span class="sr-only">メニューを開く</span></button>
    <ul id="site-nav">
      {navItems.map((item) => <li><a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.name}</a></li>)}
    </ul>
  </nav>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.querySelector('#site-nav');
  const menuLabel = button?.querySelector<HTMLElement>('.sr-only');

  const setMenuOpen = (open: boolean) => {
    button?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
    if (menuLabel) menuLabel.textContent = open ? 'メニューを閉じる' : 'メニューを開く';
  };

  button?.addEventListener('click', () => {
    setMenuOpen(button.getAttribute('aria-expanded') !== 'true');
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
</script>
