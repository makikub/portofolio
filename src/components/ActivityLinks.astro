---
import socialData from '../data/social.json';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const links = [
  { name:'Zenn', label:'技術記事', description:'実装で得た知見、試したこと、再現できる手順を公開しています。', url:socialData.links.find((link) => link.name === 'Zenn')?.url },
  { name:'X', label:'日々の発信', description:'開発、AI活用、個人開発の過程で考えたことを短く記録しています。', url:socialData.links.find((link) => link.name === 'Twitter')?.url },
].filter((link) => link.url);
---
<section class:list={['activity-section section-shell', compact && 'activity-section--compact']} aria-labelledby="activity-title">
  <div class="section-heading split-heading"><div><p class="kicker">WRITING & NOTES</p>{compact ? <h2 id="activity-title">考えたことを、外へ。</h2> : <h1 id="activity-title">発信活動</h1>}</div><p>経験をその場限りにせず、次の判断に使える形で残します。</p></div>
  <div class="activity-list">
    {links.map((link, index) => <a href={link.url} target="_blank" rel="noopener noreferrer"><span>0{index + 1}</span><div><p class="kicker">{link.name}</p><h2>{link.label}</h2><p>{link.description}</p></div><span class="arrow" aria-hidden="true">↗</span></a>)}
  </div>
</section>
