---
import projectsData from '../data/projects.json';
import ProjectVisual from './ProjectVisual.astro';

interface Props { heading?: string; description?: string; compact?: boolean; }
const { heading = '作ったもの', description = '日々の小さな摩擦から始め、配布と継続的な改善まで扱っているプロダクトです。', compact = false } = Astro.props;
---
<section id="work" class:list={['work-section section-shell', compact && 'work-section--compact']} aria-labelledby="work-title">
  <div class="section-heading split-heading">
    <div><p class="kicker">SELECTED WORK</p><h2 id="work-title">{heading}</h2></div>
    <p>{description}</p>
  </div>
  <div class="project-list">
    {projectsData.projects.map((project, index) => (
      <article class="project-card">
        <a href={`/projects/${project.slug}/`} class="project-image" aria-label={`${project.title}のケーススタディを見る`}>
          <ProjectVisual project={project.title as 'ScreenshotApp' | 'GlassDB'} />
        </a>
        <div class="project-body">
          <div class="project-index"><span>0{index + 1}</span><span>{project.role}</span></div>
          <h3><a href={`/projects/${project.slug}/`}>{project.title}</a></h3>
          <p class="project-description">{project.description}</p>
          <dl>
            <div><dt>CONTEXT</dt><dd>{project.challenge}</dd></div>
            <div><dt>OUTCOME</dt><dd>{project.result}</dd></div>
          </dl>
          <div class="project-footer">
            <ul aria-label="使用技術">{project.technologies.slice(0, 5).map((tech) => <li>{tech}</li>)}</ul>
            <a class="text-link" href={`/projects/${project.slug}/`}>ケースを見る <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
