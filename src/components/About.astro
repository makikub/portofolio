---
import profileData from '../data/profile.json';

const { about } = profileData;
---

<section id="about" class="py-18 md:py-24 px-6 bg-white border-b border-neutral-200">
  <div class="container">
    <div class="mb-12">
      <p class="text-sm font-semibold text-neutral-500 mb-3">Profile</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-neutral-900">
        {about.title}
      </h1>
    </div>

    <div class="max-w-3xl">
      <div class="prose prose-lg">
        {about.paragraphs.map((paragraph, index) => (
          <p class={`text-neutral-600 leading-relaxed ${index < about.paragraphs.length - 1 ? 'mb-6' : 'mb-8'}`}>
            {paragraph}
          </p>
        ))}

        <!-- CTA -->
        <div class="pt-4">
          <a 
            href={about.ctaLink}
            class="inline-flex items-center text-neutral-900 hover:text-neutral-600 font-medium transition-colors link-underline"
          >
            {about.ctaText}
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
