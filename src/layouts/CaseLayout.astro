---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectVisual from '../components/ProjectVisual.astro';

interface Props {
  title: 'ScreenshotApp' | 'GlassDB';
  lead: string;
  meta: string[];
  context: string;
  decision: string;
  verification: string;
  operation: string;
  liveUrl: string;
  githubUrl: string;
}
const { title, lead, meta, context, decision, verification, operation, liveUrl, githubUrl } = Astro.props;
---
<Layout title={`${title} — Case Study`} description={lead}>
  <Header />
  <main class="case-page">
    <header class="case-hero section-shell">
      <a class="back-link" href="/">← 作ったもの</a>
      <div class="case-title-grid"><div><p class="kicker">CASE STUDY</p><h1>{title}</h1></div><p>{lead}</p></div>
      <ul class="case-meta">{meta.map((item) => <li>{item}</li>)}</ul>
      <ProjectVisual project={title} />
    </header>
    <section class="case-story section-shell" aria-label="ケーススタディ詳細">
      <article><span>01</span><div><p class="kicker">CONTEXT</p><h2>摩擦を見つける</h2></div><p>{context}</p></article>
      <article><span>02</span><div><p class="kicker">DECISION</p><h2>体験を一つの流れにする</h2></div><p>{decision}</p></article>
      <article><span>03</span><div><p class="kicker">VERIFICATION</p><h2>動作を確かめる</h2></div><p>{verification}</p></article>
      <article><span>04</span><div><p class="kicker">OPERATION</p><h2>届け続ける仕組み</h2></div><p>{operation}</p></article>
    </section>
    <section class="case-links section-shell"><div><p class="kicker">SEE IT IN USE</p><h2>プロダクトを見る</h2></div><div><a class="button-link" href={liveUrl} target="_blank" rel="noopener noreferrer">公開ページ <span>↗</span></a><a class="button-link muted" href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a></div></section>
  </main>
  <Footer />
</Layout>
